{
  "name": "fidelius",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:production": "CLOUDFLARE_ENV=production tsc -b && CLOUDFLARE_ENV=production vite build",
    "preview": "npm run build && vite preview",
    "deploy": "wrangler deploy --keep-vars",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b && vite build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource/imperial-script": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "hono": "^4.11.1",
    "jose": "^6.2.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.8.2",
    "reicon-react": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@tailwindcss/vite": "^4.1.12",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.123.0"
  }
}
