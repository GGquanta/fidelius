{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fidelius",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  // 必须写在顶层。写在 env.production 里会被忽略，部署时会删掉 Dashboard 里的 var。
  "keep_vars": true,
  "vars": {
    "ENVIRONMENT": "development",
    "BOOTSTRAP_ADMIN_EMAIL": "admin@example.com",
    "TEAM_DOMAIN": "https://example.cloudflareaccess.com",
    "ACCESS_AUD": "dev-aud-not-real"
  },
  // 不写 id：本地用模拟 KV；Workers Builds 部署时自动创建真实命名空间。
  "kv_namespaces": [
    {
      "binding": "FIDELIUS"
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "access": {
    "dev": {
      "aud": "fidelius",
      "identity": {
        "email": "admin@example.com"
      }
    }
  },
  "env": {
    "production": {
      "name": "fidelius",
      "workers_dev": false,
      "preview_urls": false,
      // vars 不可继承：这里只能写生产需要覆盖的键。Dashboard 里的
      // BOOTSTRAP_ADMIN_EMAIL / TEAM_DOMAIN / ACCESS_AUD 靠顶层 keep_vars 保留。
      "vars": {
        "ENVIRONMENT": "production"
      },
      "kv_namespaces": [
        {
          "binding": "FIDELIUS"
        }
      ]
    }
  }
}
